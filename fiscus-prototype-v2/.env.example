# Postgres (Neon, via `vercel integration add neon`) — pulled automatically
# into .env.local by `vercel env pull`, not hand-set.
DATABASE_URL=

# Vercel Blob — private store "fiscus-documents" (file storage for uploaded
# statements), OIDC-authenticated via BLOB_STORE_ID + VERCEL_OIDC_TOKEN. Both
# are pulled by `vercel env pull`, not hand-set. No static
# BLOB_READ_WRITE_TOKEN is used since the store is private.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Single shared-password auth gate (PRD MVP has one authenticated user type)
APP_PASSWORD=
# Random string used to sign session cookies — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# LLM — OpenAI-compatible endpoint (OpenCode Go -> DeepSeek Flash v4.1)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Local API dev server port (proxied by Vite — see vite.config.ts)
API_PORT=8787
